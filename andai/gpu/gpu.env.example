# Salin menjadi andai/gpu/gpu.env (tidak di-commit) dan isi. Server GPU boleh diganti kapan saja:
# cukup ubah GPU_HOST/GPU_PORT/GPU_USER lalu jalankan `bash andai/gpu/gpu.sh kunci` dan `... siapkan`.
GPU_HOST=alamat-atau-ip-server-gpu
GPU_PORT=22
GPU_USER=ubuntu
# Kunci SSH khusus proyek ini (dibuat otomatis oleh `gpu.sh kunci`). Jangan simpan password di file mana pun.
GPU_KEY=$HOME/.ssh/andai_gpu
# Folder proyek di server GPU (relatif terhadap home) dan toko aset di mesin ini
REMOTE_DIR=Video-editor
ANDAI_ASET=$HOME/andai-aset
